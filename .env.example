# ================================================================
# 销售培训系统 — 生产环境变量模板
# ================================================================
# 使用方法：
#   1. 复制为 .env :  cp .env.example .env
#   2. 修改其中的敏感值（密码、Key 等）
#   3. 确保 .env 不会被提交到 git（已在 .gitignore 中）
#
# 所有变量使用 SALES_TRAINING_ 前缀，由 backend/app/core/config.py 加载。
# ================================================================

# ---------- App ----------
SALES_TRAINING_APP_NAME=SalesTrainingAPI
SALES_TRAINING_APP_VERSION=1.0.0
SALES_TRAINING_DEBUG=false

# ---------- 数据库 (格式: mysql+asyncmy://用户:密码@主机:端口/库名) ----------
# 生产环境务必修改为强密码！Docker Compose 内主机名为 mysql
SALES_TRAINING_DATABASE_URL=mysql+asyncmy://training:ChangeMe123!@mysql:3306/sales_training

# ---------- JWT 认证 ----------
# 务必改为随机长字符串！（生成命令: openssl rand -base64 48）
SALES_TRAINING_JWT_SECRET_KEY=change-me-to-a-random-secret-in-production
SALES_TRAINING_JWT_ALGORITHM=HS256
SALES_TRAINING_JWT_EXPIRE_MINUTES=120

# ---------- CORS (允许跨域来源，逗号分隔) ----------
SALES_TRAINING_CORS_ORIGINS=["*"]

# ---------- 文件上传目录 (容器内路径，一般不用改) ----------
SALES_TRAINING_UPLOAD_DIR=/app/uploads

# ---------- Celery / Redis ----------
SALES_TRAINING_CELERY_BROKER_URL=redis://redis:6379/0
SALES_TRAINING_CELERY_RESULT_BACKEND=redis://redis:6379/0

# ---------- AI 出题（阿里云百炼 Qwen-Omni） ----------
SALES_TRAINING_AI_API_KEY=sk-你的百炼APIKey
SALES_TRAINING_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SALES_TRAINING_AI_MODEL=qwen3.5-omni-flash
SALES_TRAINING_AI_QUESTION_TEXT_MODEL=qwen3.6-flash
SALES_TRAINING_AI_REQUEST_TIMEOUT_SECONDS=120

# AI 视频处理参数
SALES_TRAINING_AI_VIDEO_FPS=1
SALES_TRAINING_AI_VIDEO_MAX_INLINE_MB=100
SALES_TRAINING_AI_VIDEO_MAX_DATA_URL_CHARS=10000000
SALES_TRAINING_AI_VIDEO_COMPRESS_MAX_WIDTH=480
SALES_TRAINING_AI_VIDEO_COMPRESS_CRF=38
SALES_TRAINING_AI_VIDEO_COMPRESS_AUDIO_BITRATE=32k

# ---------- 分页 ----------
SALES_TRAINING_DEFAULT_PAGE_SIZE=20
SALES_TRAINING_MAX_PAGE_SIZE=100
