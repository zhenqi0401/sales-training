# ================================================================
# 销售培训系统 — 生产环境变量模板
# ================================================================
# 使用方法：
#   1. 复制为 .env :  cp .env.example .env
#   2. 修改其中的敏感值（密码、Key 等）
#   3. 确保 .env 不会被提交到 git（已在 .gitignore 中）
#
# 所有变量使用 SALES_TRAINING_ 前缀，由 backend/app/core/config.py 加载。
# ================================================================

# ---------- App ----------
SALES_TRAINING_APP_NAME=SalesTrainingAPI
SALES_TRAINING_APP_VERSION=1.0.0
SALES_TRAINING_DEBUG=false

# ---------- 数据库 (格式: mysql+asyncmy://用户:密码@主机:端口/库名) ----------
# 生产环境务必修改为强密码！Docker Compose 内主机名为 mysql
SALES_TRAINING_DATABASE_URL=mysql+asyncmy://training:ChangeMe123!@mysql:3306/sales_training

# ---------- JWT 认证 ----------
# 务必改为随机长字符串！（生成命令: openssl rand -base64 48）
SALES_TRAINING_JWT_SECRET_KEY=change-me-to-a-random-secret-in-production
SALES_TRAINING_JWT_ALGORITHM=HS256
SALES_TRAINING_JWT_EXPIRE_MINUTES=120

# ---------- CORS (允许跨域来源，逗号分隔) ----------
SALES_TRAINING_CORS_ORIGINS=["*"]

# ---------- 文件上传目录 (容器内路径，一般不用改) ----------
SALES_TRAINING_UPLOAD_DIR=/app/uploads

# ---------- OSS 对象存储 (阿里云) ----------
# 打开 OSS_ENABLED 后，视频上传/发布走 OSS；关闭时回退本地 uploads 目录。
# Bucket 需设为「公共读」，学员端直接用公共 URL 播放。
SALES_TRAINING_OSS_ENABLED=false
SALES_TRAINING_OSS_ACCESS_KEY_ID=你的AccessKeyID
SALES_TRAINING_OSS_ACCESS_KEY_SECRET=你的AccessKeySecret
SALES_TRAINING_OSS_BUCKET=你的Bucket名称
SALES_TRAINING_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# 可选：CDN/自定义域名（含 https://，不带末尾斜杠）；留空则用 https://{bucket}.{endpoint}
SALES_TRAINING_OSS_PUBLIC_BASE_URL=

# ---------- AI 出题 / 转写 / 话术演练（火山引擎方舟 Doubao） ----------
# AI_API_KEY 填火山引擎 ARK API Key（控制台 → 火山方舟 → API Key 管理）。
# 出题、语音转写、方法论统一走 Responses API；话术演练 Agent 走 chat/completions。
SALES_TRAINING_AI_API_KEY=ark-你的火山方舟APIKey
SALES_TRAINING_AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SALES_TRAINING_AI_MODEL=doubao-seed-2-0-mini-260428
SALES_TRAINING_AI_QUESTION_TEXT_MODEL=doubao-seed-2-0-mini-260428
SALES_TRAINING_METHODOLOGY_MODEL=doubao-seed-2-0-mini-260428
SALES_TRAINING_AGENT_MODEL=doubao-seed-2-0-mini-260428
SALES_TRAINING_AI_REQUEST_TIMEOUT_SECONDS=120

# ---------- 分页 ----------
SALES_TRAINING_DEFAULT_PAGE_SIZE=20
SALES_TRAINING_MAX_PAGE_SIZE=100
